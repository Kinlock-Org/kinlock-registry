{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinlock.org/schemas/attester.schema.json",
  "title": "Attester",
  "description": "Public identity of an attester organization and the countries it may vouch for. File: attesters/<handle>.json. No personal data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["handle", "display_name", "address", "countries"],
  "properties": {
    "handle": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Must match the file name" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "address": { "type": "string", "pattern": "^[GC][A-Z2-7]{55}$", "description": "Stellar address registered on-chain as an attester" },
    "countries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2" }
    }
  }
}
